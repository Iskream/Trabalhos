using System;
public class aposta {
    public static void Main(String[] args) {
        Random rand = new Random();
        int time = 0;
        int pontos = 0;
        int[,] tabela_jogador = new int[13, 3];
        int[,] tabela_oficial = new int[13, 3];
        for (int i = 0; i < 13; i++) {
            time++;
            Console.WriteLine("time " + time + "Você acha que vai vencer[1], empate[2] perda[3]");
            int escolha = Convert.ToInt32(Console.ReadLine());
            tabela_jogador[i, escolha - 1] = 1;
        }
        for (int i = 0; i < 13; i++) {
            int resultado = rand.Next(0, 3);
            tabela_oficial[i, resultado] = 1;
        }
        for (int i = 0; i < 13; i++) {
            for (int j = 0; j < 3; j++) {
                if (tabela_jogador[i, j] == 1 && tabela_oficial[i, j] == 1) {
                    pontos++;
                }
            }
        }
        Console.WriteLine("Você fez " + pontos + " pontos");
    }
}
