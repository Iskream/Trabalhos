using System;
public class sapo_03 {
    public static void Main(String[]args) {
        Console.WriteLine("Digite o tamanho do vetor!"); 
        int N = Convert.ToInt32(Console.ReadLine());
        int[] lagoa = new int[N]; 
        Console.WriteLine("Digite onde tem folha e onde nao tem"); 
        for (int i = 0; i < N; i++){ 
            lagoa[i] = Convert.ToInt32(Console.ReadLine()); 
        }
        int[] fib = new int[N];
        fib[0] = 1;
        fib[1] = 2;
        int qtdFib = 2;
        while (fib[qtdFib - 1] <= N + 1) {
            fib[qtdFib] = fib[qtdFib - 1] + fib[qtdFib - 2];
            qtdFib++;
        }
        int posicao = -1;
        int saltos = 0;
        while (posicao < N) {
            bool encontrou = false;
            for (int i = qtdFib - 1; i >= 0; i--) {
                int proxima = posicao + fib[i];
                if (proxima == N) {
                    saltos++;
                    posicao = N;
                    encontrou = true;
                    break;
                }
                if (proxima >= 0 && proxima < N && lagoa[proxima] == 1) {
                    saltos++;
                    posicao = proxima;
                    encontrou = true;
                    break;
                }
            }
            if (!encontrou)
            {
                Console.WriteLine("Nao e possível atravessar.");
                return;
            }
        }
        Console.WriteLine("Numero minimo de saltos: " + saltos);
    }
}
